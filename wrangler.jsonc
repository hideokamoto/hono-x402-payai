{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hono-x402-payai",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "PAY_TO": "0xc6C1Fe4FaCFB120BCb8A4BdC4c9E83E123E73eaE",
    "NETWORK": "eip155:84532"
  },
